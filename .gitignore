/target
**/*.rs.bk
*.pdb

# Signing keys must never be committed. The fetcher's private key is the trust
# root for every bundle it produces; leaking it lets anyone forge a bundle that
# an airgapped importer would accept.
*.key
*.sec
minisign.key

# Release artifacts produced by `cargo xtask dist`.
/dist/out

# Source RPMs produced by `packaging/rpm/make-srpm.sh`. The vendored crate tree
# is only ever written to a temporary directory by that script, but debugging
# the spec by hand tends to leave one here.
/packaging/rpm/out
/vendor
